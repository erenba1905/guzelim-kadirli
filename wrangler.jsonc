{
  "name": "guzelim-kadirli",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guzelim-kadirli-db",
